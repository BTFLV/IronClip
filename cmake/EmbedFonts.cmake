# Generates a C++ translation unit holding font files as byte arrays, so the
# editor never depends on bundle resources or Windows resource scripts.
#
# ironclip_embed_fonts(<output-dir> <Name>=<path> ...)
#   produces <output-dir>/EmbeddedFonts.h and EmbeddedFonts.cpp with
#   ironclip::resources::k<Name> and k<Name>Size.
function(ironclip_embed_fonts out_dir)
  set(header "// Generated by cmake/EmbedFonts.cmake\n#pragma once\n\nnamespace ironclip::resources\n{\n")
  set(source "// Generated by cmake/EmbedFonts.cmake\n#include \"EmbeddedFonts.h\"\n\nnamespace ironclip::resources\n{\n")
  foreach(entry IN LISTS ARGN)
    string(REPLACE "=" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){24})" "\\1\n" bytes "${bytes}")
    string(APPEND header "extern const unsigned char k${name}[${size}];\ninline constexpr int k${name}Size = ${size};\n")
    string(APPEND source "const unsigned char k${name}[${size}] = {\n${bytes}\n};\n\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  endforeach()
  string(APPEND header "} // namespace ironclip::resources\n")
  string(APPEND source "} // namespace ironclip::resources\n")
  # Only touch the outputs when their content changes.
  file(WRITE "${out_dir}/EmbeddedFonts.h.tmp" "${header}")
  file(WRITE "${out_dir}/EmbeddedFonts.cpp.tmp" "${source}")
  configure_file("${out_dir}/EmbeddedFonts.h.tmp" "${out_dir}/EmbeddedFonts.h" COPYONLY)
  configure_file("${out_dir}/EmbeddedFonts.cpp.tmp" "${out_dir}/EmbeddedFonts.cpp" COPYONLY)
endfunction()
